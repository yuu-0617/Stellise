DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTP_HOST} ^www\.stellise-app\.com$ [NC,OR]
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://stellise-app.com%{REQUEST_URI} [R=301,L]

  RewriteRule ^support-manual\.md$ - [F,L]
  RewriteRule ^api/chat/?$ api/chat.php [L]
  RewriteRule ^api/health/?$ api/health.php [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
